# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Credentials (Public client-side safe)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Resend Credentials (Server-only secret)
# RESEND_API_KEY is never exposed to the frontend.
RESEND_API_KEY="re_123456789"
RESEND_TO_EMAIL="felipe@example.com"
TATTOO_ARTIST_EMAIL="felipe@example.com"

# Meta Pixel ID (Client-side tracking with LGPD consent)
VITE_META_PIXEL_ID="1234567890123456"
